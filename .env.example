# Supabase 대시보드 > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# 서버에서만 쓴다. 절대 NEXT_PUBLIC_ 을 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# 푸시 알림 (없으면 알림 기능만 조용히 꺼진다)
#   npx web-push generate-vapid-keys 로 한 번 만들어서 넣는다
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:내메일@example.com

# 기한 알림(매일 아침)을 도는 cron 을 잠그는 열쇠. 아무 긴 문자열이나 넣으면 된다.
#   비워두면 /api/cron/due 는 401 로 막힌다 — 이 주소는 누구나 부를 수 있기 때문이다.
#   Vercel 프로젝트 환경변수에도 같은 값을 넣으면 Vercel 이 알아서 헤더를 붙여 부른다.
CRON_SECRET=
